    "Kaydırdıkça yüzeydeki kaslar kalkar, derindekiler ortaya çıkar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Schieben werden die oberflächlichen Muskeln entfernt und die tieferen sichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you slide, the surface muscles come away and the deeper ones appear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al deslizar, se retiran los músculos superficiales y aparecen los profundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En faisant glisser, les muscles superficiels s'enlèvent et les plus profonds apparaissent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırdıkça yüzeydeki kaslar kalkar, derindekiler ortaya çıkar."
          }
        }
      }
    },
