    "Saydam yaptığın katmanın içinden alttaki yapılara dokunabilirsin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch eine transparente Ebene kannst du darunterliegende Strukturen antippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can tap structures through a transparent layer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes tocar las estructuras a través de una capa transparente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez toucher les structures à travers une couche transparente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saydam yaptığın katmanın içinden alttaki yapılara dokunabilirsin."
          }
        }
      }
    },
    "Saydam yaptığın katmanın içinden alttaki yapılara dokunabilirsin. Deri katmanı beta aşamasında; geliştirmeye devam ediyoruz." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch eine transparente Ebene kannst du darunterliegende Strukturen antippen. Die Hautebene ist in der Beta; wir verbessern sie weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can tap structures through a transparent layer. The skin layer is in beta; we keep improving it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes tocar las estructuras a través de una capa transparente. La capa de piel está en beta; seguimos mejorándola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez toucher les structures à travers une couche transparente. La couche de peau est en bêta ; nous continuons à l'améliorer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saydam yaptığın katmanın içinden alttaki yapılara dokunabilirsin. Deri katmanı beta aşamasında; geliştirmeye devam ediyoruz."
          }
        }
      }
    },
