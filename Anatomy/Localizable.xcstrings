    "Rahim, yumurtalıklar, fallop tüpleri, kadın mesanesi ve meme bezi Human Reference Atlas 3D referans organlarından (Visible Human Female, NIH) alınmış ve atlasa hizalanmıştır. Creative Commons Atıf 4.0 (CC BY 4.0)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebärmutter, Eierstöcke, Eileiter, weibliche Harnblase und Brustdrüse stammen aus den 3D-Referenzorganen des Human Reference Atlas (Visible Human Female, NIH) und sind am Atlas ausgerichtet. Creative Commons Namensnennung 4.0 (CC BY 4.0)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The uterus, ovaries, uterine tubes, female bladder and mammary gland come from the Human Reference Atlas 3D reference organs (Visible Human Female, NIH), aligned to the atlas. Creative Commons Attribution 4.0 (CC BY 4.0)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El útero, los ovarios, las trompas uterinas, la vejiga femenina y la glándula mamaria proceden de los órganos de referencia 3D del Human Reference Atlas (Visible Human Female, NIH), alineados con el atlas. Creative Commons Atribución 4.0 (CC BY 4.0)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'utérus, les ovaires, les trompes utérines, la vessie féminine et la glande mammaire proviennent des organes de référence 3D du Human Reference Atlas (Visible Human Female, NIH), alignés sur l'atlas. Creative Commons Attribution 4.0 (CC BY 4.0)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahim, yumurtalıklar, fallop tüpleri, kadın mesanesi ve meme bezi Human Reference Atlas 3D referans organlarından (Visible Human Female, NIH) alınmış ve atlasa hizalanmıştır. Creative Commons Atıf 4.0 (CC BY 4.0)."
          }
        }
      }
    },
