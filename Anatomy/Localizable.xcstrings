    "Kadın modeli" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weibliches Modell"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Female model"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo femenino"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèle féminin"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadın modeli"
          }
        }
      }
    },
    "Kadın modelinin beden biçimi (göğüs ve kasık dahil) MakeHuman'ın CC0 (kamu malı) taban modelinden alınmıştır; iskelet, kas, organlar ve deri bu biçime göre şekillendirilir." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Körperform des weiblichen Modells (einschließlich Brust und Leiste) stammt aus dem CC0-Basismodell (gemeinfrei) von MakeHuman; Skelett, Muskeln, Organe und Haut sind daran angepasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The female body shape (including breasts and groin) comes from MakeHuman's CC0 (public domain) base model; the skeleton, muscles, organs and skin are shaped to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La forma corporal del modelo femenino (incluidos el pecho y la ingle) procede del modelo base CC0 (dominio público) de MakeHuman; el esqueleto, los músculos, los órganos y la piel se adaptan a ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La morphologie du modèle féminin (poitrine et région inguinale comprises) provient du modèle de base CC0 (domaine public) de MakeHuman ; squelette, muscles, organes et peau y sont adaptés."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadın modelinin beden biçimi (göğüs ve kasık dahil) MakeHuman'ın CC0 (kamu malı) taban modelinden alınmıştır; iskelet, kas, organlar ve deri bu biçime göre şekillendirilir."
          }
        }
      }
    },
