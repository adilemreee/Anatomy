    "İnceleme modunda Latince oluşumları, kasların başlangıç ve tutunma yerlerini işaretli gör." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Präparatmodus siehst du beschriftete Knochenmerkmale sowie Ursprung und Ansatz jedes Muskels."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In inspection mode, see labelled bone features and where each muscle arises and inserts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el modo examen verás los accidentes óseos señalados y el origen y la inserción de cada músculo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mode examen, voyez les repères osseux annotés ainsi que l'origine et la terminaison de chaque muscle."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnceleme modunda Latince oluşumları, kasların başlangıç ve tutunma yerlerini işaretli gör."
