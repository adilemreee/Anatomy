    },
    "Kemikler, eklemler, kaslar, kalp ve damarlar için 369 ayrıntılı madde, yaklaşık 500 işaretli kemik oluşumu, üç düzeyde 760 özgün soru ve 3.000'e yakın bilgi kartı, tek bir uygulamada." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "369 ausführliche Artikel zu Knochen, Gelenken, Muskeln, Herz und Gefäßen, rund 500 beschriftete Knochenmerkmale, 760 originale Fragen auf drei Niveaus und fast 3.000 Lernkarten – in einer App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "369 detailed articles on bones, joints, muscles, the heart and vessels, about 500 labelled bone landmarks, 760 original questions at three levels and nearly 3,000 flashcards, in one app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "369 fichas detalladas de huesos, articulaciones, músculos, corazón y vasos, unos 500 relieves óseos señalados, 760 preguntas originales en tres niveles y casi 3.000 tarjetas, en una sola app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "369 fiches détaillées sur les os, les articulations, les muscles, le cœur et les vaisseaux, environ 500 repères osseux annotés, 760 questions originales sur trois niveaux et près de 3 000 cartes, dans une seule app."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemikler, eklemler, kaslar, kalp ve damarlar için 369 ayrıntılı madde, yaklaşık 500 işaretli kemik oluşumu, üç düzeyde 760 özgün soru ve 3.000'e yakın bilgi kartı, tek bir uygulamada."
          }
        }
      }
    },
    "Kemikler, eklemler, kaslar, kalp, damarlar ve sinir sistemi için 424 ayrıntılı madde, yaklaşık 500 işaretli kemik oluşumu, üç düzeyde 900 özgün soru ve 3.000'i aşkın bilgi kartı, tek bir uygulamada." : {

    },
    "Kemikleri, eklemleri ve kasları döndür, yakınlaştır, katman katman aç." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knochen, Gelenke und Muskeln drehen, zoomen und Schicht für Schicht freilegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotate, zoom and peel back bones, joints and muscles layer by layer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira, amplía y descubre huesos, articulaciones y músculos capa a capa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites pivoter, zoomez et dévoilez os, articulations et muscles couche par couche."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemikleri, eklemleri ve kasları döndür, yakınlaştır, katman katman aç."
          }
        }
      }
    },
