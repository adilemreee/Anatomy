    "Latince terimler Terminologia Anatomica 2 (FIPAT) listesine dayanır; terimlerin kendisi kamu malıdır. İngilizce kaynak metinler Wikipedia tabanlıdır (CC BY-SA). Türkçe maddeler, parça açıklamaları ve sorular bu uygulama için özgün olarak hazırlanmıştır." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die lateinischen Begriffe folgen der Terminologia Anatomica 2 (FIPAT); die Begriffe selbst sind gemeinfrei. Die englischen Referenztexte beruhen auf Wikipedia (CC BY-SA). Artikel, Teilbeschreibungen und Fragen wurden eigens für diese App verfasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latin terms follow Terminologia Anatomica 2 (FIPAT); the terms themselves are in the public domain. The English reference texts are based on Wikipedia (CC BY-SA). The articles, part descriptions and questions were written originally for this app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los términos latinos siguen la Terminologia Anatomica 2 (FIPAT); los términos en sí son de dominio público. Los textos de referencia en inglés se basan en Wikipedia (CC BY-SA). Las fichas, las descripciones de piezas y las preguntas se han escrito expresamente para esta app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les termes latins suivent la Terminologia Anatomica 2 (FIPAT) ; les termes eux-mêmes sont du domaine public. Les textes de référence en anglais s'appuient sur Wikipédia (CC BY-SA). Les fiches, descriptions et questions ont été rédigées spécialement pour cette app."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latince terimler Terminologia Anatomica 2 (FIPAT) listesine dayanır; terimlerin kendisi kamu malıdır. İngilizce kaynak metinler Wikipedia tabanlıdır (CC BY-SA). Türkçe maddeler, parça açıklamaları ve sorular bu uygulama için özgün olarak hazırlanmıştır."
          }
        }
      }
    },
    "Latince terimler, kanlanma, sinir, klinik bilgi ve her maddede TUS notları" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lateinische Begriffe, Blutversorgung, Innervation, Klinik und prüfungsrelevante Hinweise in jedem Artikel"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latin terms, blood supply, innervation, clinical notes and high-yield points in every article"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Términos latinos, irrigación, inervación, datos clínicos y claves de examen en cada ficha"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termes latins, vascularisation, innervation, données cliniques et points clés dans chaque fiche"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latince terimler, kanlanma, sinir, klinik bilgi ve her maddede TUS notları"
          }
        }
      }
    },
