          "stringUnit" : {
            "state" : "translated",
            "value" : "Bone, muscle, joint, ligament…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hueso, músculo, articulación, ligamento…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os, muscle, articulation, ligament…"
