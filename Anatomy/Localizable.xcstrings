    "Kaslar yaptıkları harekete göre, kemikler tek tek ayırt edilecek şekilde renklendirilir." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muskeln sind nach ihrer Bewegung eingefärbt, Knochen so, dass jeder einzeln erkennbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscles are coloured by the movement they produce, bones so each one stands apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los músculos se colorean según su acción y los huesos de forma que cada uno se distinga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les muscles sont colorés selon leur action, les os de façon à distinguer chacun d'eux."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaslar yaptıkları harekete göre, kemikler tek tek ayırt edilecek şekilde renklendirilir."
          }
        }
      }
    },
