 "systems": {
  "skeletal": {
   "tr": "Skelettsystem",
   "summary": "Das knöcherne Gerüst des Körpers",
   "intro": "Das Skelett des Erwachsenen besteht aus etwa 206 Knochen. Knochen stützen und formen den Körper, schützen die inneren Organe, bieten den Muskeln Ansatzpunkte und ermöglichen so Bewegung, bilden im Knochenmark Blutzellen und speichern Calcium und Phosphat. Das Skelett gliedert sich in das Achsenskelett (Schädel, Wirbelsäule und Brustkorb) und das Extremitätenskelett einschließlich Schulter- und Beckengürtel."
  },
  "articular": {
   "tr": "Gelenksystem",
   "summary": "Gelenke und Bänder, die die Knochen verbinden",
   "intro": "Gelenke (Articulationes) sind die Verbindungen zwischen zwei oder mehr Knochen. Nach ihrem Bau unterscheidet man faserige, knorpelige und Synovialgelenke; nach ihrer Beweglichkeit Synarthrosen (unbeweglich), Amphiarthrosen (wenig beweglich) und Diarthrosen (frei beweglich). Synovialgelenke besitzen Gelenkknorpel, Gelenkkapsel, Synovialmembran und Synovialflüssigkeit; Bänder (Ligamenta) stabilisieren das Gelenk."
  },
  "muscular": {
   "tr": "Muskelsystem",
   "summary": "Die Skelettmuskeln, die Bewegung erzeugen",
   "intro": "Der menschliche Körper hat über 600 Skelettmuskeln, die etwa 40 % des Körpergewichts ausmachen. Jeder Muskel hat einen Ursprung, einen Ansatz, eine Innervation und eine Funktion. Skelettmuskeln sind willkürlich gesteuerte quergestreifte Muskeln; sie setzen über Sehnen an den Knochen an und bewegen die Gelenke. Auch Haltung und Wärmebildung gehören zu ihren Aufgaben."
  },
  "cardiovascular": {
   "tr": "Herz-Kreislauf-System",
   "summary": "Herz, Arterien und Venen",
   "intro": "Das Herz-Kreislauf-System besteht aus dem Herzen und den Blutgefäßen. Über den großen (Körper-)Kreislauf pumpt das Herz sauerstoffreiches Blut in alle Gewebe, über den kleinen (Lungen-)Kreislauf sauerstoffarmes Blut in die Lunge. Arterien (Arteriae) führen das Blut vom Herzen weg, Venen (Venae) zum Herzen zurück; in den Kapillaren (Capillaria) findet der Stoff- und Gasaustausch statt."
  },
  "nervous": {
   "tr": "Nervensystem",
   "summary": "Gehirn, Rückenmark und periphere Nerven",
   "intro": "Das Nervensystem ist das Steuersystem, das Reize aus dem Körperinneren und der Umwelt aufnimmt, verarbeitet und eine Antwort erzeugt. Es besteht aus dem zentralen Nervensystem (Gehirn und Rückenmark) und dem peripheren Nervensystem (12 Hirnnervenpaare, 31 Spinalnervenpaare und die Ganglien). Funktionell gliedert es sich in einen somatischen (willkürlichen) und einen autonomen (sympathischen und parasympathischen) Teil."
  }
 }
}