 "systems": {
  "skeletal": {
   "tr": "Skeletal System",
   "summary": "The bony framework of the body",
   "intro": "The adult skeleton has about 206 bones. Bones support and shape the body, protect the internal organs, give muscles their attachments and so make movement possible, produce blood cells in the bone marrow and store calcium and phosphate. The skeleton consists of the axial skeleton (skull, vertebral column and thoracic cage) and the appendicular skeleton, which includes the shoulder and pelvic girdles."
  },
  "articular": {
   "tr": "Articular System",
   "summary": "The joints and ligaments that unite the bones",
   "intro": "Joints (articulationes) are where two or more bones meet. By structure they are fibrous, cartilaginous or synovial; by mobility they are synarthroses (immovable), amphiarthroses (slightly movable) or diarthroses (freely movable). Synovial joints have articular cartilage, a joint capsule, a synovial membrane and synovial fluid; ligaments (ligamenta) stabilise the joint."
  },
  "muscular": {
   "tr": "Muscular System",
   "summary": "The skeletal muscles that produce movement",
   "intro": "The human body has more than 600 skeletal muscles, making up about 40% of body weight. Every muscle has an origin, an insertion, a nerve supply (innervation) and an action. Skeletal muscles are voluntary, striated muscles; they attach to bones through tendons and move the joints. Maintaining posture and producing heat are among their tasks too."
  },
  "cardiovascular": {
   "tr": "Cardiovascular System",
   "summary": "The heart, arteries and veins",
   "intro": "The cardiovascular system consists of the heart and the blood vessels. Through the systemic circulation the heart pumps oxygenated blood to every tissue, and through the pulmonary circulation it pumps deoxygenated blood to the lungs. Arteries (arteriae) carry blood away from the heart, veins (venae) bring it back, and exchange of substances and gases takes place in the capillaries (capillaria)."
  }
 }
